rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fundo da tela de login: lido antes de existir sessão.
    match /highlight/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Dados do usuário: cada um só lê e grava os próprios.
    match /users/{uid}/timeline/{timelineId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/watched/{movieKey} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/following/{seriesId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Premiações e franquias: leitura pública, escrita por qualquer usuário logado.
    match /oscar/{editionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /globoDeOuro/{editionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /cannes/{editionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /marvel/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dc/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mundoMagico/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /terraMedia/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /starWars/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /jornadaNasEstrelas/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /jurassicPark/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /percyJackson/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /jamesBond/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Todo o resto fica fechado. O cache do servidor (sharedCache) usa o Admin SDK, que ignora estas regras.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
