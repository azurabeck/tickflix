# Copie pra .env (ignorado pelo git) e preencha com os valores reais.
# Ver src/service/FirebaseSettings.ts — dados do projeto Firebase
# "tickflix-c2a78" (console.firebase.google.com, Configurações do projeto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# TMDb (The Movie Database) — token v4 "Read Access Token" (formato JWT,
# começa com "eyJ..."), NÃO a api_key v3 antiga. Pegue em
# themoviedb.org/settings/api, seção "API Read Access Token".
# Usada pelo wizard pra buscar a lista de filmes/séries no final do fluxo.
VITE_TMDB_API_KEY=

# API key do Gemini — aistudio.google.com/apikey. Usada pelo wizard pra
# gerar as categorias do step 2 e os detalhes das premiações dinamicamente.
# Ver o aviso de segurança em src/service/IASettings.ts antes de colocar
# uma chave de produção aqui (fica exposta no bundle do client).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash
