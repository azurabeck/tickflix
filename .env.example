# Copie pra .env (ignorado pelo git) e preencha com os valores reais.
# Ver src/service/FirebaseSettings.ts — dados do projeto Firebase
# "tickflix-c2a78" (console.firebase.google.com, Configurações do projeto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# TMDb (The Movie Database) — token v4 "Read Access Token" (formato JWT,
# começa com "eyJ..."), NÃO a api_key v3 antiga. Pegue em
# themoviedb.org/settings/api, seção "API Read Access Token".
# Usada pelo wizard pra buscar a lista de filmes/séries no final do fluxo.
VITE_TMDB_API_KEY=

# API key do Gemini (aistudio.google.com/apikey) — fica SÓ no servidor
# (api/gemini.ts), nunca no bundle do client. Quem quiser pode usar a própria
# chave em Configurações (essa chamada vai direto do navegador dele).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Backend (api/*.ts, funções serverless da Vercel) -----------------------
# Variáveis SEM prefixo VITE_ de propósito — essas nunca devem ir pro
# bundle do client, só existem no servidor. Ver api/_lib/tmdbServer.ts e
# api/_lib/firebaseAdmin.ts.

# Mesmo token v4 "Read Access Token" do TMDb usado acima
# (VITE_TMDB_API_KEY) — pode ser o mesmo valor, só que numa variável SEM
# VITE_ (lida por `process.env`, não pelo bundle do client).
TMDB_API_KEY=

# JSON INTEIRO da chave de serviço do Firebase, colado como string numa
# linha só (gere em console.firebase.google.com → Configurações do
# projeto "tickflix-c2a78" → Contas de serviço → Gerar nova chave
# privada). Dá ao backend acesso de administrador ao Firestore — NUNCA
# comite isso, nem cole aqui além do seu .env local.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Conta de teste local (opcional) — usada só pra validar a UI em desenvolvimento.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
